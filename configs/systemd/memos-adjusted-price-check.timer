# 평일 14:30 KST. 피하는 시간대: finalize 08:00·morning 09:00 (07:30~09:45), 옛 evening 18:30·capture 20:00 (18:15~21:30).
# 코드도 같은 시간대에는 KIS를 부르지 않고(adjusted_recheck.DEFAULT_BLACKOUTS), 일일 갱신 advisory lock을 잡은 뒤에만 실행한다.
# Persistent=false: 놓친 실행을 부팅 직후(수집 시간대일 수 있음)에 몰아서 하지 않는다.
[Unit]
Description=Run MEMO'S adjusted price check on weekdays at 14:30 Asia/Seoul

[Timer]
OnCalendar=Mon..Fri 14:30:00 Asia/Seoul
Persistent=false
AccuracySec=1min
RandomizedDelaySec=120
Unit=memos-adjusted-price-check.service

[Install]
WantedBy=timers.target
