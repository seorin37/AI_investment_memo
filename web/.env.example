# web/ 프론트엔드 환경변수 (Vite). 실제 백엔드에 연결하려면 이 파일을 .env.local 로 복사해서 쓴다.
# 여기에는 비밀값을 넣지 않는다 — 브라우저 번들에 그대로 들어간다. (API 키·DB 비밀번호는 백엔드 .env에만)

# true = FastAPI에 연결 (로그인 · 내 종목 · 메모 · 체크리스트 · AI 업데이트). 없거나 다른 값 = 예시 데이터로 도는 시연 모드
VITE_USE_API=true

# FastAPI 주소 (/api/v1 까지). 백엔드 CORS(AUTH_CORS_ORIGINS)에 http://localhost:8081 이 들어 있어야 한다
VITE_API_BASE_URL=http://localhost:8000/api/v1
