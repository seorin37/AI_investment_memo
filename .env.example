# 이 파일을 복사해 .env를 만들고 값을 채운다: cp .env.example .env
# .env는 절대 커밋하지 않는다.

# --- DB (로컬 개발용) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=memos
POSTGRES_PASSWORD=change_me
POSTGRES_DB=memos

# --- 외부 API 키 (각자 발급해 .env에만 입력) ---
DART_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 토스증권 Open API: 발급 후 실제 인증 항목에 맞게 이름을 수정한다
TOSS_API_KEY=
# LLM: 모델 확정 후 필요한 항목으로 수정한다
LLM_API_KEY=
