# DB (로컬 개발용. 비밀번호는 각자 정해서 .env에만 적는다)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=memos
POSTGRES_PASSWORD=change_me
POSTGRES_DB=memos

# 외부 API 키 (발급받은 값은 .env에만 적고, 절대 커밋하지 않는다)
DART_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
LLM_API_KEY=
LLM_MODEL=gemini-3.1-flash-lite

DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}

# KRX Open API (주가)
KRX_API_KEY=

# ECOS Open API (금리·환율)
ECOS_API_KEY=
