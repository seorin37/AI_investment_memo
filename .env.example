# DB (로컬 개발용. 비밀번호는 각자 정해서 .env에만 적는다)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=memos
POSTGRES_PASSWORD=change_me
POSTGRES_DB=memos

# 외부 API 키 (발급받은 값은 .env에만 적고, 절대 커밋하지 않는다)
DART_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# LLM은 OpenAI (메모 추적·AI 업데이트·메모 생성 도구가 읽는다). 모델 이름은 계정에서 쓸 수 있는 것으로 바꿔도 된다
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
# 뉴스 중복 묶음의 애매한 묶음 판정용 (cluster_assigner --llm, pipeline --cluster-llm). 위 LLM_API_KEY와 따로 읽는다 (같은 키를 써도 된다)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}
# 중앙 DB 역할별 URL: 조회 코드는 READONLY 우선, Alembic은 ALEMBIC 우선 사용
READONLY_DATABASE_URL=
ALEMBIC_DATABASE_URL=

# KIS Open API (stocks에 등록된 KOSPI 종목의 원시·수정 일봉 및 투자지표)
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_REQUEST_INTERVAL=1.05
KIS_RATE_LIMIT_COOLDOWN_SECONDS=61
# 신규 20:00 Capture / 08:00 Finalize 반복 timer 승인 전에는 false 유지
KIS_TWO_STAGE_ENABLED=false
# 0011 migration과 최초 백필 검증 전에는 반드시 false로 유지
DAILY_REFRESH_KIS_ENABLED=false
DAILY_REFRESH_KOSPI_MASTER_MIN_COUNT=500

# KRX Open API (종목 기본정보·KOSPI/KOSDAQ 지수·금)
KRX_API_KEY=

# ECOS Open API (금리·환율)
ECOS_API_KEY=

#FRED Open API
FRED_API_KEY=

# 소셜 OAuth / MEMO'S JWT (비밀값은 실제 .env 또는 운영 secret store에만 저장)
# openssl rand -base64 48 등으로 충분히 긴 무작위 값을 생성한다.
AUTH_JWT_SECRET=
AUTH_JWT_ISSUER=memos-api
AUTH_JWT_AUDIENCE=memos-app
AUTH_PUBLIC_BASE_URL=http://localhost:8000
AUTH_WEB_RETURN_URLS=http://localhost:8081/auth/callback
AUTH_MOBILE_RETURN_URLS=memos://auth/callback
AUTH_CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
# localhost HTTP 개발에서만 false. 운영 HTTPS는 반드시 true.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
KAKAO_OAUTH_CLIENT_ID=
KAKAO_OAUTH_CLIENT_SECRET=
NAVER_OAUTH_CLIENT_ID=
NAVER_OAUTH_CLIENT_SECRET=
