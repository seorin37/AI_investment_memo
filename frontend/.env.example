# ─────────────────────────────────────────────────────────────
# MEMO'S 프론트엔드 환경 변수 (.env 로 복사해서 사용)
# EXPO_PUBLIC_ 접두사가 붙은 값만 앱 번들에 포함됩니다. 비밀키는 넣지 마세요.
# ─────────────────────────────────────────────────────────────

# FastAPI 서버 주소 (강의실 PC · WSL2 · Docker Compose)
#  - 같은 PC 브라우저(웹 개발):       http://localhost:8000/api/v1
#  - 휴대폰 Expo Go(같은 Wi-Fi):     http://<강의실PC_IPv4>:8000/api/v1
#  - Android 에뮬레이터:             http://10.0.2.2:8000/api/v1
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# true  → 목업 데이터로 화면 개발 (백엔드 없이 실행)
# false → 실제 FastAPI 호출
EXPO_PUBLIC_USE_MOCK=true

# 목업 응답 지연(ms) — 로딩 상태 확인용
EXPO_PUBLIC_MOCK_LATENCY=250
